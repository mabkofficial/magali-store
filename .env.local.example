# Copy to .env.local for local development. Production: Vercel → Environment Variables.

# Site
NEXT_PUBLIC_SITE_URL=https://magali.store

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

# Admin (comma-separated emails allowed to sign in at /admin)
ADMIN_EMAILS=

# Stripe (use test keys until go-live checklist is complete)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (transactional email — required for orders + contact form delivery)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
RESEND_FROM_EMAIL=Magali <hello@magali.store>

# Shipping (USD cents)
STANDARD_SHIPPING_RATE_CENTS=799
FROZEN_SHIPPING_RATE_CENTS=2499
FROZEN_CHECKOUT_ENABLED=false

# Public email shown in footer (orders/contact still go to CONTACT_TO_EMAIL)
NEXT_PUBLIC_CONTACT_EMAIL=hello@shop.magali.store

# Optional — footer & analytics
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_GA_ID=
